# ── Server ──────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── PostgreSQL ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://tarkify_user:tarkifyPassword@localhost:5439/tarkifyDB
PG_USER=tarkify_user
PG_PASSWORD=tarkifyPassword
PG_DB=tarkifyDB

# ── Better Auth ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-at-least-32-chars-long
# Base URL of the API server (used for email links, redirects, and OAuth callbacks).
# When using Docker (docker compose), use the host-mapped port (3009).
# For non-Docker development (bun run), change to http://localhost:3001.
# For production, set to https://backend.tarkify.qzz.io (or your domain).
BETTER_AUTH_URL=http://localhost:3009

# ── Google OAuth ────────────────────────────────────────────────────
# Client ID and Secret from Google Cloud Console (Credentials → OAuth 2.0).
# Both are required for Google sign-in.  Omit both to disable it.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# ── Razorpay ────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Email (Resend) ───────────────────────────────────────────────────
# Get API key from https://resend.com/api-keys
# RESEND_API_KEY is optional in dev (emails are logged, not sent); required in production.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Sender address. Must use a domain verified in the Resend dashboard.
# Without a verified domain, only the account owner's address can receive emails.
FROM_EMAIL=noreply@tarkify.com
# Reply-to header on all outgoing emails.
REPLY_TO_EMAIL=support@tarkify.com
# Recipient for admin notifications (contact forms, career applications).
ADMIN_EMAIL=admin@tarkify.com
# Email provider (only "resend" is implemented).
# EMAIL_PROVIDER=resend

# ── CORS ────────────────────────────────────────────────────────────
# Frontend origin for CORS and trusted origins.
# In development: http://localhost:5173
# In production: https://tarkify.qzz.io (or your frontend domain).
FRONTEND_URL=http://localhost:5173

# ── Storage ─────────────────────────────────────────────────────────
STORAGE_PATH=./storage

# ── Download Tokens ─────────────────────────────────────────────────
DOWNLOAD_TOKEN_TTL_SECONDS=600
