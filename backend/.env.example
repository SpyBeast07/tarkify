# ── Server ──────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── PostgreSQL ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://tarkify_user:tarkifyPassword@localhost:5439/tarkifyDB
PG_USER=tarkify_user
PG_PASSWORD=tarkifyPassword
PG_DB=tarkifyDB

# ── Better Auth ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-at-least-32-chars-long
# Base URL of the API server (used for email links and redirects)
BETTER_AUTH_URL=http://localhost:3001

# ── Razorpay ────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── CORS ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Storage ─────────────────────────────────────────────────────────
STORAGE_PATH=./storage

# ── Download Tokens ─────────────────────────────────────────────────
DOWNLOAD_TOKEN_TTL_SECONDS=600
