# ── Environment ─────────────────────────────────────────────────────
# Set to "development" for local dev, "production" for deployment.
# Controls cookie prefixes, error verbosity, and Razorpay key warnings.
# When using Docker Compose, override via shell: NODE_ENV=production docker compose up
# (defaults to "production" in docker-compose.yml).
NODE_ENV=development

# ── Server ──────────────────────────────────────────────────────────
PORT=3001

# ── PostgreSQL ──────────────────────────────────────────────────────
# For Docker dev: postgresql://user:pass@localhost:5439/dbname
# For Docker prod: postgresql://user:pass@postgres:5432/dbname (internal Docker network)
DATABASE_URL=postgresql://tarkify_user:tarkifyPassword@localhost:5439/tarkifyDB
PG_USER=tarkify_user
PG_PASSWORD=tarkifyPassword
PG_DB=tarkifyDB

# ── Better Auth ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-at-least-32-chars-long
# Public-facing URL of the API server (used for OAuth redirects, email links).
#   Dev (Docker):   http://localhost:3009
#   Dev (bun run):  http://localhost:3001
#   Production:     https://backend.tarkify.qzz.io (or your domain)
BETTER_AUTH_URL=http://localhost:3009

# ── Google OAuth ────────────────────────────────────────────────────
# Client ID and Secret from Google Cloud Console (Credentials → OAuth 2.0).
# Both are required for Google sign-in. Omit both to disable it entirely.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret

# ── Razorpay ────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Email (Resend) ───────────────────────────────────────────────────
# Get API key from https://resend.com/api-keys
# RESEND_API_KEY is optional in dev (emails are logged, not sent); required in production.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Sender address. Must use a domain verified in the Resend dashboard.
FROM_EMAIL=noreply@tarkify.com
# Reply-to header on all outgoing emails.
REPLY_TO_EMAIL=support@tarkify.com
# Recipient for admin notifications (contact forms, career applications).
ADMIN_EMAIL=admin@tarkify.com

# ── Frontend ────────────────────────────────────────────────────────
# Used for CORS, trusted origins, and redirect validation.
#   Dev:   http://localhost:5173
#   Prod:  https://tarkify.qzz.io (or your frontend domain)
FRONTEND_URL=http://localhost:5173

# ── Storage ─────────────────────────────────────────────────────────
STORAGE_PATH=./storage

# ── Download Tokens ─────────────────────────────────────────────────
DOWNLOAD_TOKEN_TTL_SECONDS=600

# ── Managed Admin Account ──────────────────────────────────────────
# Automatically created/synchronized on startup.
ADMIN_NAME=Administrator
ADMIN_PASSWORD=change_this_password
